# Copy this file to .env.development or .env.production and fill in the secrets.
APP_ENV=development
DEBUG=true

# 0.0.0.0 lets the ESP32 nodes of the gallery network reach the Edge API.
EDGE_HOST=0.0.0.0
EDGE_PORT=5000
EDGE_DATABASE_PATH=storepulse_edge.db
EDGE_SYNC_INTERVAL_SECONDS=30

# StorePulse REST API that receives the synchronized telemetry.
BACKEND_API_URL=http://localhost:8080/api/v1
BACKEND_API_TOKEN=

# Same Base64 value as JWT_SECRET in the StorePulse REST API.
JWT_SECRET=
JWT_ISSUER=storepulse-rest-api
